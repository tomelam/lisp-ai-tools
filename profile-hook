#!/bin/sh
# tools/profile-hook PROJECT-DIR KIND -- Claude Code hook that logs a call for the profile (tools/profile.lisp).
# KIND is pre (before the call, for a project with no guard), post (the call ran) or failure (the call ran and failed).
# Reads the hook JSON on stdin and appends "epoch TAB KIND TAB json" to PROJECT-DIR/run/profile/events.log, but only while
# PROJECT-DIR/run/profile/on exists. It never prints a decision and always exits 0, so it can never block a call.
dir=$1
kind=$2
payload=$(cat)
[ -f "$dir/run/profile/on" ] || exit 0
mkdir -p "$dir/run/profile"
printf '%s\t%s\t%s\n' "$(date +%s)" "$kind" "$payload" >> "$dir/run/profile/events.log"
exit 0
