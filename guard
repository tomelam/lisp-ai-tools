#!/bin/sh
# tools/guard PROJECT-DIR -- Claude Code PreToolUse hook for Bash: refuse the text-processing programs in the project's
# rules/forbidden-programs.sexp. Every project's bin/guard is a wrapper that passes its directory here; the project's name
# is the name of that directory, which is also the name of its <name>.asd.
# Reads the hook JSON on stdin. Prints a "deny" decision on stdout, or nothing to allow.
# Fast path: ask the always-on image (bin/lisp-server). Slow path, a fresh SBCL, when it is not running,
# so enforcement never depends on the server. If the guard itself cannot run it denies: a guard that
# fails open looks exactly like one that works.
here=$1
name=$(basename "$here")
tools=$(cd "$(dirname "$0")" && pwd)
cd "$here" && mkdir -p run
socket=${LISP_AI_SOCKET:-run/lisp.sock}
if [ -S "$socket" ]; then
  # no exec: a stale socket file (the server died) makes nc fail with no output, and no output means "allow".
  # The server's reply counts only when it starts with OK: (lisp-ai-hook:socket-marker); the rest is the hook's answer.
  # Anything else (nc cannot reach the server, a dropped connection, a server that does not know hook payloads and
  # read it as Lisp) takes the slow path.
  input=$(cat)
  if reply=$(printf '%s' "$input" | nc -w 10 -U "$socket"); then
    case $reply in
      OK:*) printf '%s' "${reply#OK:}"; exit 0 ;;
    esac
  fi
  printf '%s' "$input" > run/guard-input.json
  exec < run/guard-input.json
fi
bin/qlot exec sbcl --noinform --non-interactive \
  --eval "(let ((*standard-output* *error-output*))
            (asdf:load-asd (truename \"$name.asd\"))
            (asdf:load-system \"lisp-ai-tools/hook\"))" \
  --load "$tools/guard-main.lisp" 2>run/guard.stderr
status=$?
if [ "$status" -ne 0 ]; then
  echo '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"bin/guard failed to run (exit status non-zero); see run/guard.stderr"}}'
fi
exit 0
