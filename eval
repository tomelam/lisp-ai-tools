#!/bin/sh
# tools/eval PROJECT-DIR '(form)' -- evaluate Lisp in the project's always-on image (in the project's own package) and
# print the values. Every project's bin/eval is a wrapper that passes its directory here.
# A server that is down (a stale socket counts as down) is started with bin/lisp-server first, and stderr says so;
# a start that fails, or a server that does not answer, is an error on stderr and a non-zero exit.
here=$1
shift
socket="$here/run/lisp.sock"
if ! state=$("$here/bin/lisp-server" status 2>&1); then
  echo "lisp-server was down ($state); starting it" >&2
  "$here/bin/lisp-server" start >&2 || { echo "lisp-server could not be started; see run/lisp-server.log" >&2; exit 1; }
fi
printf '%s' "$1" | nc -w 300 -U "$socket" || { echo "no answer from lisp-server on $socket" >&2; exit 1; }
